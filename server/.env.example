# =====================================================================
# LevelUp Server — Environment Configuration Template
# Copy this file to .env (or upload to Vercel Environment Variables)
# =====================================================================

# Server Port
PORT=5000

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=development

# MongoDB Connection String (Atlas or Local)
# Ensure 0.0.0.0/0 is whitelisted in MongoDB Atlas Network Access for cloud deploys
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# JWT Secret — MUST be a cryptographically random string (32 chars minimum, 64+ recommended).
# REQUIRED in production. Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_64_CHAR_HEX_STRING

# JWT Token Lifetime (default 7d)
JWT_EXPIRES_IN=7d

# Client URL for CORS (comma-separated for multiple origins)
# Vercel preview hosts and localhost are automatically handled
CLIENT_URL=http://localhost:5173

# Groq AI API Keys — Get from https://console.groq.com
GROQ_API_KEY=gsk_your_primary_groq_api_key_here
GROQ_API_KEY_2=gsk_your_secondary_groq_api_key_here

# Cloudinary Storage — For profile picture and file uploads
# Get from https://console.cloudinary.com
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Staff Signup Code — Shared secret required to register faculty/HOD/principal accounts
# Leave blank or unset to disable self-registration for staff
# STAFF_SIGNUP_CODE=your_staff_registration_secret_code

# Demo Access Controls
# Allow 1-click demo accounts on the login page (default true)
ALLOW_DEMO_LOGIN=true

# Demo Mode data synthesis (default true in development, false in production)
DEMO_MODE=false

# Optional AI discovery features
ENABLE_AI_DISCOVERY=false
