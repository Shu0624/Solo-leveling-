# =====================================================================
# LevelUp Server — Environment Configuration
# Copy this file to .env and fill in your values
# =====================================================================

# MongoDB connection string
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# JWT Secret — MUST be a cryptographically random string (64+ chars)
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_64_CHAR_HEX_STRING

# JWT token lifetime (default 7d). Shorter = safer if a token is stolen.
JWT_EXPIRES_IN=7d

# Groq API Key — Get from https://console.groq.com
GROQ_API_KEY=gsk_your_api_key_here
# Optional second key for round-robin / fallback
# GROQ_API_KEY_2=gsk_your_second_api_key_here

# Client URL for CORS (comma-separated for multiple origins)
CLIENT_URL=http://localhost:5173

# Server port
PORT=5000

# Demo mode — when 'true', dashboards synthesize sample academic/placement
# metrics (CGPA, package predictions, etc.) for empty data. Defaults to ON
# outside production and OFF in production. NEVER enable in a real deployment.
# DEMO_MODE=false
