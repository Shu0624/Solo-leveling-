# =====================================================================
# LevelUp Server — Environment Configuration
# Copy this file to .env and fill in your values
# =====================================================================

# MongoDB connection string
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# JWT Secret — MUST be a cryptographically random string (32 chars minimum,
# 64+ recommended). REQUIRED in production: with NODE_ENV=production and no
# JWT_SECRET set, the server refuses to sign or verify tokens rather than
# falling back to a shared secret that is published in this repository.
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_64_CHAR_HEX_STRING

# JWT token lifetime (default 7d). Shorter = safer if a token is stolen.
JWT_EXPIRES_IN=7d

# Groq API Key — Get from https://console.groq.com
GROQ_API_KEY=gsk_your_api_key_here
# Optional second key for round-robin / fallback
# GROQ_API_KEY_2=gsk_your_second_api_key_here

# Staff signup code — REQUIRED to register a faculty / HOD / principal /
# placement account. Staff roles can read every student record in scope, so
# the role is proven with this shared code rather than simply chosen from the
# signup dropdown. Leave it UNSET to forbid staff self-registration entirely
# (accounts must then be created directly in the database).
# Generate with: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# STAFF_SIGNUP_CODE=

# Client URL for CORS (comma-separated for multiple origins).
# Origins not listed here are rejected — with the exception of *.vercel.app
# preview hosts, and localhost outside production. Unset in production means
# same-origin only, which is correct for the single-domain Vercel deploy.
CLIENT_URL=http://localhost:5173

# Server port
PORT=5000

# One-click demo login on the sign-in page. Defaults ON outside production and
# OFF in production — set to 'true' to expose it on a production deployment.
# ALLOW_DEMO_LOGIN=false

# Demo mode — when 'true', dashboards synthesize sample academic/placement
# metrics (CGPA, package predictions, etc.) for empty data. Defaults to ON
# outside production and OFF in production. NEVER enable in a real deployment.
# DEMO_MODE=false
